{
  "kind": "plugin",
  "name": "github-issues",
  "version": "0.1.0",
  "papercusp": "^0.1.0",
  "description": "GitHub Issues as a ticket provider: issues become ticket records, open/close/reopen become ticket-status-change events, issue comments become ticket-comment documents, and the host can post a comment on an issue (ticket.comment). Synced by the host's connector driver; the plugin only maps GitHub's REST API.",
  "author": "Papercusp",
  "license": "MIT",
  "main": "./index.cjs",
  "capabilities": [],
  "tools": [],
  "provider": {
    "id": "github-issues",
    "contractVersion": 1,
    "displayName": "GitHub Issues",
    "datatypes": ["ticket", "ticket-status-change", "ticket-comment"],
    "capabilities": ["ticket.read", "ticket.comment"],
    "oauth": {
      "authorizeUrl": "https://github.com/login/oauth/authorize",
      "tokenUrl": "https://github.com/login/oauth/access_token",
      "scopes": ["repo"],
      "clientRegistrationRef": "github",
      "identity": {
        "url": "https://api.github.com/user",
        "idField": "id",
        "displayNameField": "login"
      }
    },
    "setup": {
      "credentials": [
        {
          "key": "personal_access_token",
          "label": "Personal access token",
          "help": "Instead of signing in with an OAuth app, paste a GitHub personal access token that can read and comment on the repository's issues. Issues and comments are then created as that token's account.",
          "helpUrl": "https://github.com/settings/personal-access-tokens",
          "placeholder": "github_pat_...",
          "pattern": "(?:ghp_|gho_|ghu_|github_pat_)[A-Za-z0-9_]{20,255}",
          "hosts": ["api.github.com"]
        }
      ]
    },
    "membership": { "identityProvider": "github" },
    "egressHosts": ["api.github.com", "github.com"],
    "defaultDestinations": {
      "ticket": ["record"],
      "ticket-status-change": ["event"],
      "ticket-comment": ["document"]
    },
    "configSchema": {
      "type": "object",
      "required": ["owner", "repo"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "harnessSlug": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
