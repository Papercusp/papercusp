{
  "distribution": "cupboard",
  "kind": "plugin", "name": "tiktok", "version": "0.1.0", "papercusp": "^0.1.0",
  "description": "Read-only TikTok Display API provider. Recorded-fake verification; live verification pending.",
  "author": "Papercusp", "license": "MIT", "main": "./index.cjs",
  "runtime": { "kind": "daemon", "daemonCommand": ["node", "daemon.cjs"] },
  "capabilities": [], "tools": [],
  "provider": {
    "rateBudget": {
      "verifiedAt": "2026-08-23",
      "sources": [
        "https://developers.tiktok.com/doc/tiktok-api-v2-video-list",
        "https://developers.tiktok.com/doc/display-api-get-started/",
        "https://developers.tiktok.com/doc/tiktok-api-scopes/",
        "https://developers.tiktok.com/doc/content-posting-api-get-started/",
        "https://developers.tiktok.com/doc/content-posting-api-reference-upload-video/",
        "https://developers.tiktok.com/doc/content-posting-api-reference-get-video-status/",
        "https://developers.tiktok.com/doc/content-sharing-guidelines/"
      ],
      "notes": "NO rate limit is documented for the Display API (/v2/video/list/) on either its reference or its get-started page — verified 2026-08-23, an absence rather than an unread field. The published TikTok limits (6 req/min inbox init, 30 req/min status fetch, both per user access_token) belong to Content Posting endpoints this read-only row never calls. max_count is the one hard documented bound on this endpoint: default 10, maximum 20."
    },
    "verification": {
      "verifiedAt": "2026-10-16",
      "sources": [
        "https://developers.tiktok.com/doc/tiktok-api-v2-video-list",
        "https://developers.tiktok.com/doc/login-kit-web/",
        "https://developers.tiktok.com/doc/oauth-user-access-token-management/"
      ],
      "capabilities": {}
    },
    "id": "tiktok", "contractVersion": 1, "displayName": "TikTok", "datatypes": ["social-post"], "capabilities": [],
    "egressHosts": ["open.tiktokapis.com", "www.tiktok.com"],
    "oauth": {
      "authorizeUrl": "https://www.tiktok.com/v2/auth/authorize/", "tokenUrl": "https://open.tiktokapis.com/v2/oauth/token/",
      "scopes": ["user.info.basic", "video.list"], "scopeSeparator": ",", "clientIdParameter": "client_key", "clientRegistrationRef": "tiktok",
      "identity": { "url": "https://open.tiktokapis.com/v2/user/info/?fields=open_id,display_name", "idField": "data.user.open_id", "displayNameField": "data.user.display_name" }
    },
    "setup": { "appRegistration": {
      "createUrl": "https://developers.tiktok.com/apps/", "docsUrl": "https://developers.tiktok.com/doc/display-api-get-started/",
      "copyHint": "Register Login Kit and Display API, configure the OAuth callback, and request user.info.basic and video.list. Content Posting scopes are not needed."
    } },
    "defaultDestinations": { "social-post": ["document", "event"] },
    "configSchema": {
      "type": "object", "required": ["openId"],
      "properties": {
        "openId": { "type": "string", "minLength": 1, "title": "Connected TikTok open id" },
        "maxCount": { "type": "integer", "minimum": 1, "maximum": 20, "default": 20 },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }, "additionalProperties": false
    }
  }
}
