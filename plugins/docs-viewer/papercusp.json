{
  "name": "@papercupai/docs-viewer",
  "version": "0.1.1",
  "kind": "plugin",
  "papercusp": "^0.1.0",
  "description": "Embed the harness's docs site (Fumadocs) as a dashboard tab.",
  "author": "Papercusp",
  "license": "MIT",
  "capabilities": [
    "ui:dashboard-tab"
  ],
  "dashboardTabs": [
    {
      "id": "docs",
      "label": "Docs",
      "icon": "BookOpen",
      "iframeUrlConfigKey": "docsUrl",
      "replaces": ["docs"]
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "docsUrl": {
        "type": "string",
        "default": "http://localhost:3055/docs",
        "description": "Base URL of the docs site."
      }
    }
  }
}