{
  "distribution": "cupboard",
  "kind": "plugin", "name": "devto", "version": "0.1.0", "papercusp": "^0.1.0",
  "description": "Cross-post Markdown to dev.to as a draft or published article with a papercusp.com canonical URL. Fixture-verified; not live-verified.",
  "author": "Papercusp", "license": "MIT", "main": "./index.cjs",
  "runtime": { "kind": "daemon", "daemonCommand": ["node", "daemon.cjs"] },
  "capabilities": [], "tools": [],
  "provider": {
    "id": "devto", "contractVersion": 1, "displayName": "dev.to", "datatypes": ["blog-post"], "sync": false,
    "capabilities": ["blog.post"], "egressHosts": ["dev.to"],
    "verification": {
      "verifiedAt": "2026-10-17", "capabilities": { "blog.post": "2026-10-17" },
      "sources": ["https://developers.forem.com/api/v1", "https://raw.githubusercontent.com/forem/forem/main/swagger/v1/api_v1.json"]
    },
    "setup": { "credentials": [{
      "key": "api_key", "label": "dev.to API key", "hosts": ["dev.to"], "auth": { "header": "api-key", "scheme": "raw" },
      "help": "Create an API key in your dev.to account settings. The host stores it and supplies the api-key header.",
      "helpUrl": "https://dev.to/settings/extensions"
    }] },
    "configSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  }
}
