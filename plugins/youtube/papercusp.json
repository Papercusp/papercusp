{
  "distribution": "cupboard",
  "kind": "plugin", "name": "youtube", "version": "0.1.0", "papercusp": "^0.1.0",
  "description": "YouTube channel activities, comments and paged replies through host-held Google OAuth. Live verification pending.",
  "author": "Papercusp", "license": "MIT", "main": "./index.cjs",
  "runtime": { "kind": "daemon", "daemonCommand": ["node", "daemon.cjs"] }, "capabilities": [], "tools": [],
  "provider": {
    "rateBudget": {
      "verifiedAt": "2026-08-23",
      "sources": [
        "https://developers.google.com/youtube/v3/getting-started",
        "https://developers.google.com/youtube/v3/docs/activities/list",
        "https://developers.google.com/youtube/v3/docs/commentThreads/list",
        "https://developers.google.com/youtube/v3/docs/comments/insert",
        "https://developers.google.com/youtube/v3/docs/videos/insert"
      ],
      "quotaUnitsPerDay": 10000,
      "buckets": {
        "general": {
          "appliesTo": "all endpoints except search.list and videos.insert (activities.list 1, commentThreads.list 1, comments.list 1, comments.insert 50)",
          "perDay": 10000,
          "unit": "units",
          "verbs": [
            "read",
            "reply",
            "delete"
          ]
        },
        "search": {
          "appliesTo": "search.list",
          "perDay": 100,
          "unit": "calls",
          "notes": "A separate allocation; unused general units cannot buy another search."
        },
        "videoUploads": {
          "appliesTo": "videos.insert",
          "perDay": 100,
          "unit": "calls",
          "verbs": [
            "post"
          ],
          "notes": "The \"Video Uploads quota bucket\". Each call costs 1 unit, NOT the widely-repeated 1600 — that figure is stale, and the real constraint is this 100-CALL ceiling, which no amount of unused general quota replenishes (D-020)."
        }
      },
      "notes": "THREE non-fungible budgets, verified against two independent vendor pages (D-020). A cap derived from quotaUnitsPerDay alone is meaningless for uploads and searches, so a per-verb consumer must read `buckets`."
    },
    "verification": {
      "verifiedAt": "2026-10-16",
      "sources": [
        "https://developers.google.com/youtube/v3/docs/activities/list",
        "https://developers.google.com/youtube/v3/docs/commentThreads/list",
        "https://developers.google.com/youtube/v3/docs/comments/list",
        "https://developers.google.com/youtube/v3/docs/comments/insert"
      ],
      "capabilities": {
        "social.reply": "2026-10-16"
      }
    },
    "id": "youtube", "contractVersion": 1, "displayName": "YouTube", "datatypes": ["social-post"], "capabilities": ["social.reply"],
    "egressHosts": ["www.googleapis.com", "accounts.google.com", "oauth2.googleapis.com", "openidconnect.googleapis.com"],
    "oauth": {
      "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&prompt=consent&include_granted_scopes=true", "tokenUrl": "https://oauth2.googleapis.com/token",
      "scopes": ["openid", "profile", "https://www.googleapis.com/auth/youtube.readonly", "https://www.googleapis.com/auth/youtube.force-ssl"],
      "clientRegistrationRef": "google", "credentialGroup": "google", "pkce": true,
      "identity": { "url": "https://openidconnect.googleapis.com/v1/userinfo", "idField": "sub", "displayNameField": "name" }
    },
    "setup": { "appRegistration": {
      "createUrl": "https://console.cloud.google.com/apis/credentials", "docsUrl": "https://developers.google.com/youtube/v3/guides/auth/server-side-web-apps",
      "copyHint": "Enable YouTube Data API v3 on the Google app, configure its OAuth callback and consent scopes, and add test users while the app is in testing."
    } },
    "defaultDestinations": { "social-post": ["document", "event"] },
    "configSchema": {
      "type": "object", "required": ["channelId"],
      "properties": {
        "channelId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "Channel id" },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 20 },
        "maxReplyPages": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 20 }
      }, "additionalProperties": false
    }
  }
}
