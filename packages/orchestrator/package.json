{
  "name": "@papercusp/orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the Papercusp harness orchestrator. Default since v0.0.x — set PAPERCUSP_USE_TS_ORCHESTRATOR=0 only as an emergency escape hatch back to the deprecated bash run.sh. Drops the bash prereq for Windows users while keeping the agent CLI shell-out (default `omp -p` via Meridian + Claude Max OAuth, or `claude -p` when AGENT_BACKEND=claude-code) so Claude Max subscriptions continue to work without API keys.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./state": {
      "types": "./src/state.ts",
      "import": "./src/state.ts",
      "default": "./src/state.ts"
    },
    "./role-prompt": {
      "types": "./src/role-prompt-from-slug.ts",
      "import": "./src/role-prompt-from-slug.ts",
      "default": "./src/role-prompt-from-slug.ts"
    },
    "./role-models": {
      "types": "./src/role-models.ts",
      "import": "./src/role-models.ts",
      "default": "./src/role-models.ts"
    },
    "./decision-parse": {
      "types": "./src/decision-parse.ts",
      "import": "./src/decision-parse.ts",
      "default": "./src/decision-parse.ts"
    },
    "./blueprint": {
      "types": "./src/blueprint/index.ts",
      "import": "./src/blueprint/index.ts",
      "default": "./src/blueprint/index.ts"
    },
    "./mission-state-pg": {
      "types": "./src/mission-state-pg.ts",
      "import": "./src/mission-state-pg.ts",
      "default": "./src/mission-state-pg.ts"
    },
    "./dispatches-pg": {
      "types": "./src/dispatches-pg.ts",
      "import": "./src/dispatches-pg.ts",
      "default": "./src/dispatches-pg.ts"
    },
    "./checkpoints-pg": {
      "types": "./src/checkpoints-pg.ts",
      "import": "./src/checkpoints-pg.ts",
      "default": "./src/checkpoints-pg.ts"
    },
    "./run-output-pg": {
      "types": "./src/run-output-pg.ts",
      "import": "./src/run-output-pg.ts",
      "default": "./src/run-output-pg.ts"
    },
    "./run-chunks-pg": {
      "types": "./src/run-chunks-pg.ts",
      "import": "./src/run-chunks-pg.ts",
      "default": "./src/run-chunks-pg.ts"
    },
    "./snapshots-pg": {
      "types": "./src/snapshots-pg.ts",
      "import": "./src/snapshots-pg.ts",
      "default": "./src/snapshots-pg.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "papercusp-orchestrate": "./bin/run.ts"
  },
  "scripts": {
    "test": "vitest run && vitest run --config vitest.dispatcher.config.ts",
    "test:unit": "vitest run",
    "test:legacy": "node --test --import tsx src/**/*.test.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts --testTimeout 600000",
    "test:dispatcher": "vitest run --config vitest.dispatcher.config.ts"
  },
  "dependencies": {
    "@papercusp/file-claim": "*",
    "@papercusp/locks": "*",
    "@papercusp/harness": "*",
    "@papercusp/rules": "*",
    "@papercusp/step-program": "*",
    "postgres": "^3.4.5",
    "tsx": "^4.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "vitest": "^4.1.4"
  }
}
