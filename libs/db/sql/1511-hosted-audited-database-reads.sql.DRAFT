-- P-013: extend 1509's scoped reader with live consent and a committed audit
-- receipt bound to this exact backend transaction. No parallel audit table.
DO $role$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'harness_ops') THEN
    CREATE ROLE harness_ops NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
  END IF;
END
$role$;
GRANT USAGE ON SCHEMA papercusp_auth TO harness_ops;

CREATE OR REPLACE FUNCTION papercusp_auth.read_hosted_customer_export_rows_audited(
  p_store text, p_organization_id text, p_session_id uuid,
  p_staff_principal_id text, p_grant_id uuid
)
RETURNS TABLE(data jsonb)
LANGUAGE plpgsql SECURITY DEFINER
SET search_path = pg_catalog
AS $function$
DECLARE
  v_transaction_started text;
BEGIN
  IF session_user <> 'harness_ops'
     OR current_database() <> 'papercusp_hosted'
     OR current_setting('transaction_read_only') <> 'on'
     OR current_setting('app.workspace_id', true) IS DISTINCT FROM 'hosted-control-plane-service'
     OR current_setting('app.organization_id', true) IS DISTINCT FROM p_organization_id
     OR p_organization_id IS NULL OR btrim(p_organization_id) = ''
     OR p_staff_principal_id IS NULL OR btrim(p_staff_principal_id) = '' THEN
    RAISE EXCEPTION 'audited database read session scope is invalid' USING ERRCODE = '42501';
  END IF;
  SELECT xact_start::text INTO v_transaction_started
    FROM pg_stat_activity WHERE pid = pg_backend_pid();
  IF NOT EXISTS (
    SELECT 1 FROM papercusp_auth.support_access_grants
     WHERE id = p_grant_id AND organization_id::text = p_organization_id
       AND staff_principal_id = p_staff_principal_id AND workspace_id IS NULL
       AND scopes @> ARRAY['database:read']::text[]
       AND starts_at <= clock_timestamp() AND expires_at > clock_timestamp()
       AND revoked_at IS NULL
  ) THEN
    RAISE EXCEPTION 'audited database read consent is inactive' USING ERRCODE = '42501';
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM papercusp_auth.organization_audit_events
     WHERE organization_id::text = p_organization_id
       AND actor_kind = 'staff_admin' AND actor_id = p_staff_principal_id
       AND action = 'database.break_glass.opened'
       AND target_type = 'database_session' AND target_id = p_session_id::text
       AND metadata->>'grantId' = p_grant_id::text
       AND metadata->>'role' = 'harness_ops'
       AND metadata->>'backendPid' = pg_backend_pid()::text
       AND metadata->>'transactionStartedAt' = v_transaction_started
       AND metadata->>'serverStartedAt' = pg_postmaster_start_time()::text
  ) OR EXISTS (
    SELECT 1 FROM papercusp_auth.organization_audit_events
     WHERE organization_id::text = p_organization_id AND target_id = p_session_id::text
       AND action IN ('database.break_glass.closed', 'database.break_glass.close_failed')
  ) THEN
    RAISE EXCEPTION 'audited database read has no matching open receipt' USING ERRCODE = '42501';
  END IF;
  RETURN QUERY SELECT * FROM papercusp_auth.read_hosted_customer_export_rows(p_store, p_organization_id);
END
$function$;

ALTER FUNCTION papercusp_auth.read_hosted_customer_export_rows_audited(text, text, uuid, text, uuid) OWNER TO hosted_owner;
REVOKE ALL ON FUNCTION papercusp_auth.read_hosted_customer_export_rows_audited(text, text, uuid, text, uuid)
  FROM PUBLIC, harness_app, harness_zero, hosted_app, hosted_service;
GRANT EXECUTE ON FUNCTION papercusp_auth.read_hosted_customer_export_rows_audited(text, text, uuid, text, uuid) TO harness_ops;

DO $postconditions$
BEGIN
  IF has_table_privilege('hosted_service', 'papercusp_auth.support_access_grants', 'SELECT')
     OR has_table_privilege('hosted_service', 'papercusp_auth.organization_audit_events', 'SELECT')
     OR has_table_privilege('harness_ops', 'papercusp_auth.support_access_grants', 'SELECT')
     OR has_table_privilege('harness_ops', 'papercusp_auth.organization_audit_events', 'INSERT') THEN
    RAISE EXCEPTION '1511: service and ops roles must not receive direct governance access';
  END IF;
END
$postconditions$;
