-- P007 extends the existing signed contract. No second identity/member/document store.
-- Enforce the same refusal under concurrent candidate requests, including other writers.
CREATE UNIQUE INDEX IF NOT EXISTS dao_hr_work_profiles_verified_wallet_uniq
  ON harness_shared.dao_hr_work_profiles (workspace_id,dao_slug,wallet_chain_id,wallet_address)
  WHERE wallet_verified_at IS NOT NULL AND wallet_address IS NOT NULL;

ALTER TABLE harness_shared.dao_hr_contracts
  ADD COLUMN IF NOT EXISTS candidate_github_id bigint CHECK (candidate_github_id > 0),
  ADD COLUMN IF NOT EXISTS candidate_github_login text,
  ADD COLUMN IF NOT EXISTS hire_plan jsonb,
  ADD COLUMN IF NOT EXISTS hire_execution_proof jsonb,
  ADD COLUMN IF NOT EXISTS terms_acceptance_proof jsonb,
  ADD COLUMN IF NOT EXISTS admitted_at timestamptz;

CREATE OR REPLACE FUNCTION harness_shared.dao_hr_onboarding_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF OLD.candidate_github_id IS NOT NULL AND
    (NEW.candidate_github_id IS DISTINCT FROM OLD.candidate_github_id OR
     NEW.candidate_github_login IS DISTINCT FROM OLD.candidate_github_login) THEN
    RAISE EXCEPTION 'dao_hr candidate identity is immutable';
  END IF;
  IF OLD.hire_plan IS NOT NULL AND NEW.hire_plan IS DISTINCT FROM OLD.hire_plan THEN
    RAISE EXCEPTION 'dao_hr hire plan is immutable';
  END IF;
  IF OLD.hire_execution_proof IS NOT NULL AND
    (NEW.hire_execution_proof IS DISTINCT FROM OLD.hire_execution_proof OR
     NEW.hire_proposal_ref IS DISTINCT FROM OLD.hire_proposal_ref OR
     NEW.grant_id IS DISTINCT FROM OLD.grant_id OR
     NEW.hire_transaction_hash IS DISTINCT FROM OLD.hire_transaction_hash) THEN
    RAISE EXCEPTION 'dao_hr hire execution proof is immutable';
  END IF;
  IF OLD.terms_acceptance_proof IS NOT NULL AND NEW.terms_acceptance_proof IS DISTINCT FROM OLD.terms_acceptance_proof THEN
    RAISE EXCEPTION 'dao_hr terms acceptance proof is immutable';
  END IF;
  IF NEW.terms_acceptance_proof IS NOT NULL AND NEW.hire_execution_proof IS NULL THEN
    RAISE EXCEPTION 'dao_hr acceptance requires hire execution';
  END IF;
  IF NEW.admitted_at IS NOT NULL AND
    (NEW.candidate_github_id IS NULL OR NEW.hire_execution_proof IS NULL OR NEW.terms_acceptance_proof IS NULL) THEN
    RAISE EXCEPTION 'dao_hr admission requires identity, executed hire and acceptance';
  END IF;
  IF OLD.admitted_at IS NOT NULL AND NEW.admitted_at IS DISTINCT FROM OLD.admitted_at THEN
    RAISE EXCEPTION 'dao_hr admission proof is immutable';
  END IF;
  RETURN NEW;
END $$;
CREATE OR REPLACE TRIGGER dao_hr_onboarding_immutable BEFORE UPDATE ON harness_shared.dao_hr_contracts
  FOR EACH ROW EXECUTE FUNCTION harness_shared.dao_hr_onboarding_immutable();
