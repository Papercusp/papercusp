-- 1639 — per-subscriber fan-out delivery ledger (shared-reference-system-2026-11-13
-- P-003, R-9 / R-24..R-27 / R-33 / R-35; design D-030).
--
-- Migration 1632 kept fan-out retry state per OUTBOX ROW, so one subscriber's
-- failure re-ran the whole fan-out and the row gave up after a fixed number of
-- attempts. This table keeps that state per SUBSCRIBER instead: one row per
-- (workspace, outbox row, subscriber), written ONLY when a delivery to that
-- subscriber did not durably land. A first-pass success writes nothing here —
-- the coord_event_log row is the notification.
--
--   route   inbox      the retry sweep re-writes it into the subscriber's inbox
--                      (an explicit, blocker or contextual follow);
--           item-read  never pushed: the follower's next read of the item
--                      (work_items:get) carries it (a held-item-only follow).
--   state   pending    still to be delivered (retried with backoff, no cap);
--           written    durably written (inbox) or carried by a read (item-read);
--           failed     the subscription ended before delivery (R-25);
--           superseded a newer delivery of the same object to the same
--                      subscriber was durably written first (D-024).
--
-- "Delivered" (R-24) is derived, never stored: a written inbox row is delivered
-- once the recipient's committed inbox read cursor covers its timestamp.
--
-- Expand-only: one new table and two indexes. The deployed release never names
-- this table, so it keeps working unchanged.

CREATE TABLE IF NOT EXISTS harness_shared.substrate_fanout_deliveries (
  workspace_id            text        NOT NULL,
  outbox_id               bigint      NOT NULL,
  subscriber_id           text        NOT NULL,
  msg_id                  text        NOT NULL,
  object_kind             text        NOT NULL,
  object_ref              text        NOT NULL,
  target_kind             text        NOT NULL,
  target_ref              text        NOT NULL,
  delivery                jsonb       NOT NULL,
  route                   text        NOT NULL DEFAULT 'inbox',
  state                   text        NOT NULL DEFAULT 'pending',
  attempts                integer     NOT NULL DEFAULT 1,
  next_retry_at           bigint,
  last_error              text,
  finding_ref             text,
  end_reason              text,
  superseded_by_outbox_id bigint,
  read_at                 timestamptz,
  created_at              timestamptz NOT NULL DEFAULT now(),
  updated_at              timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (workspace_id, outbox_id, subscriber_id),
  CONSTRAINT substrate_fanout_deliveries_route_check CHECK (route IN ('inbox', 'item-read')),
  CONSTRAINT substrate_fanout_deliveries_state_check CHECK (state IN ('pending', 'written', 'failed', 'superseded'))
);

COMMENT ON TABLE harness_shared.substrate_fanout_deliveries IS
  'P-003 (D-030): per-subscriber fan-out delivery ledger. One row per (workspace, outbox row, subscriber), written only when that delivery did not durably land.';
COMMENT ON COLUMN harness_shared.substrate_fanout_deliveries.delivery IS
  'The resolved subscriber and inject event needed to rebuild the notification envelope on retry (a retry stamps a fresh envelope ts).';
COMMENT ON COLUMN harness_shared.substrate_fanout_deliveries.next_retry_at IS
  'Epoch ms when the retry sweep next handles this row. NULL once the row leaves pending.';
COMMENT ON COLUMN harness_shared.substrate_fanout_deliveries.finding_ref IS
  'The persistent-failure work-item filed at FANOUT_MAX_ATTEMPTS (R-27), keyed fanout-persistent:<subscriber>:outbox:<outbox_id>.';

-- The retry sweep: due pending rows of one coord workspace, oldest due first.
CREATE INDEX IF NOT EXISTS substrate_fanout_deliveries_due_idx
  ON harness_shared.substrate_fanout_deliveries (workspace_id, next_retry_at)
  WHERE state = 'pending';

-- Per subscriber: supersession, context end, first-input flush and item reads.
CREATE INDEX IF NOT EXISTS substrate_fanout_deliveries_subscriber_idx
  ON harness_shared.substrate_fanout_deliveries (workspace_id, subscriber_id, object_kind, object_ref)
  WHERE state = 'pending';
