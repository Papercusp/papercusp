SET LOCAL lock_timeout = '10s';
SET LOCAL statement_timeout = '120s';

-- Parked while replacing the full-table rewrite with a maintained scalar and
-- a separate, replay-safe backfill through the runner's statement breakpoint.

-- EI-25349866237234695: launch_spec contains multi-MB identity history. Exact
-- Sessions facets need one scalar, not a corpus-wide decode on every read.
-- Reuse the existing table; STORED backfills once and PG maintains every write,
-- including clearing/replacing launch_spec. No second summary store/cache.
ALTER TABLE harness_shared.adv_sessions
  ADD COLUMN IF NOT EXISTS launch_harness_slug text
  GENERATED ALWAYS AS (launch_spec ->> 'harnessSlug') STORED;
COMMENT ON COLUMN harness_shared.adv_sessions.launch_harness_slug IS
  'Maintained scalar launch_spec.harnessSlug projection for bounded exact Sessions facets; do not write directly.';
