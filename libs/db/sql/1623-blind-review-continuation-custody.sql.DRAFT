-- EI-28042943843506687 / D-001. FORWARD-COMPAT: additive draft ledger;
-- no legacy writer uses it. Original bindings and uniqueness stay unchanged.
CREATE TABLE harness_shared.blind_review_continuation_custody (
  id bigserial PRIMARY KEY,
  workspace_id text NOT NULL,
  binding_id bigint NOT NULL REFERENCES harness_shared.plan_blind_review_sessions(id),
  reservation_id bigint REFERENCES harness_shared.blind_review_continuation_custody(id),
  event_kind text NOT NULL CHECK (event_kind IN ('reserved', 'transferred')),
  resume_lease_id uuid NOT NULL,
  source_adv_session_id bigint NOT NULL REFERENCES harness_shared.adv_sessions(id),
  target_adv_session_id bigint NOT NULL REFERENCES harness_shared.adv_sessions(id),
  port_id uuid NOT NULL REFERENCES harness_shared.session_ports(id),
  snapshot jsonb NOT NULL CHECK (jsonb_typeof(snapshot) = 'object'),
  evidence jsonb NOT NULL CHECK (jsonb_typeof(evidence) = 'object'),
  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
  CHECK ((event_kind = 'reserved') = (reservation_id IS NULL)),
  CHECK (source_adv_session_id <> target_adv_session_id)
);
CREATE UNIQUE INDEX blind_review_continuation_source_uidx
  ON harness_shared.blind_review_continuation_custody (workspace_id, binding_id, source_adv_session_id)
  WHERE event_kind = 'reserved';
CREATE UNIQUE INDEX blind_review_continuation_target_uidx
  ON harness_shared.blind_review_continuation_custody (workspace_id, target_adv_session_id)
  WHERE event_kind = 'reserved';
CREATE UNIQUE INDEX blind_review_continuation_port_uidx
  ON harness_shared.blind_review_continuation_custody (workspace_id, port_id)
  WHERE event_kind = 'reserved';
CREATE UNIQUE INDEX blind_review_continuation_transfer_uidx
  ON harness_shared.blind_review_continuation_custody (reservation_id)
  WHERE event_kind = 'transferred';
CREATE INDEX blind_review_continuation_binding_idx
  ON harness_shared.blind_review_continuation_custody (workspace_id, binding_id, id);
CREATE FUNCTION harness_shared.reject_blind_review_continuation_mutation()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  RAISE EXCEPTION 'blind-review continuation custody is append-only';
END;
$$;
CREATE TRIGGER blind_review_continuation_append_only
  BEFORE UPDATE OR DELETE ON harness_shared.blind_review_continuation_custody
  FOR EACH ROW EXECUTE FUNCTION harness_shared.reject_blind_review_continuation_mutation();
ALTER TABLE harness_shared.blind_review_continuation_custody ENABLE ROW LEVEL SECURITY;
CREATE POLICY workspace_isolation ON harness_shared.blind_review_continuation_custody
  USING (workspace_id = current_setting('app.workspace_id', true))
  WITH CHECK (workspace_id = current_setting('app.workspace_id', true));
-- PostgreSQL row-locking SELECTs require UPDATE privilege; the trigger still
-- rejects every UPDATE/DELETE, including for the application role.
GRANT SELECT, INSERT, UPDATE ON harness_shared.blind_review_continuation_custody TO harness_app, harness_admin;
GRANT USAGE, SELECT ON SEQUENCE harness_shared.blind_review_continuation_custody_id_seq TO harness_app, harness_admin;
